# Зависимости Node.js (огромные, собираются заново)
node_modules/

# Секреты и переменные окружения (НИКОГДА не коммитить!)
.env

# Логи и временные файлы
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Результаты сборки (для React/Vite/Webpack)
dist/
build/
*.tgz

# Покрытие тестами
coverage/
.nyc_output/

# macOS системные файлы (частая причина мусора в репозитории)
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows системный файл (на всякий случай, если кто-то откроет проект на Windows)
Thumbs.db

# Sublime Text 3 (твоя IDE)
*.sublime-project
*.sublime-workspace

# Временные файлы редакторов и бэкапы
*~
.#*
*.swp
*.swo
*.bak
